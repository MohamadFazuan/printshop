{
  "name": "printshop",
  "productName": "Printshop",
  "version": "1.0.0",
  "description": "Prompt to print-ready PDF, at any paper size.",
  "main": "src/main.js",
  "author": "OC Global Tech",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "verify": "node test/verify.js",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.ocglobaltech.printshop",
    "productName": "Printshop",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "//": "No arch list here on purpose: it overrides the --arm64/--x64 CLI flag and silently emits a second dmg whose sharp binary is for the wrong architecture.",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
